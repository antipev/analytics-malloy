import "../1_views/bridge.malloy" 


import "../1_views/order_items.malloy"
import "../1_views/users.malloy"
import "../1_views/inventory_items.malloy"
import "../1_views/products.malloy"
import "../1_views/distribution_centers.malloy"
import "../1_views/events.malloy"
import "../1_views/event_session_facts.malloy"
import "../1_views/event_session_funnel.malloy"
import "../1_views/orders.malloy"

source: ecommerce_explore is bridge extend {

  // Link to Order Management
  join_one: order_items          on _pbk_order_items = order_items.Id
  join_one: users                on _pbk_users = users.Id
  join_one: orders               on _pbk_orders = orders.Order_id
  
  // Link to Product & Inventory
  join_one: inventory_items      on _pbk_inventory_items = inventory_items.Id
  join_one: products             on _pbk_products = products.Id
  join_one: distribution_centers on _pbk_distribution_centers = distribution_centers.Id
  
  // Link to Behavioral Data
  join_one: events               on _pbk_events = events.Id
  join_one: event_session_facts  on _pbk_event_session_facts = event_session_facts.Session_id
  join_one: event_session_funnel on _pbk_event_session_funnel = event_session_funnel.Session_id

  measure:
    conversion is pick order_items.order_count
                             / events.`count`  
                            
                  when events.`count` != 0
                  else 0

}

